# Copy this file to .env and fill in real values for local development.
# On Vercel, set these under Project Settings → Environment Variables.

# Database connection string used by Prisma (via the libSQL adapter).
# Local dev default (SQLite file, already the fallback baked into
# lib/prisma.ts if this is left unset): file:./prisma/dev.db
# For a hosted libSQL/Turso database: libsql://<db-name>-<org>.turso.io?authToken=<token>
DATABASE_URL="file:./prisma/dev.db"

# Secret used to sign/verify session JWTs (lib/auth/token.ts). Required at
# runtime for login/signup to work — generate a random 32+ byte value, e.g.
# `openssl rand -base64 32`.
AUTH_SECRET=""

# Public base URL of the deployed app (used for absolute links/canonical
# URLs). Set to your Vercel deployment URL in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

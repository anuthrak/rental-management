generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum RoomStatus {
  VACANT
  OCCUPIED
  MAINTENANCE
}

enum InvoiceStatus {
  UNPAID
  PAID
  OVERDUE
}

enum SecurityDepositStatus {
  HELD
  REFUNDED
  APPLIED_TO_RENT
}

enum Currency {
  USD
  KHR
}

// A registered account. Rows across Room/Tenant/Lease/Invoice with a NULL
// userId are shared public demo data (see getScopedData in lib/db/queries.ts);
// rows owned by a User are private to that account.
model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  name                String?
  passwordHash        String
  businessName        String?
  currencyPreference  Currency @default(USD)
  defaultWaterRate    Decimal  @default(0.5)
  defaultElectricRate Decimal  @default(0.25)
  invoiceNoteTemplate String?
  tourCompleted       Boolean  @default(false)
  // Seeds useSimpleModeStore's initial value once per fresh browser/device
  // (see hydrateFromAccount) — a user's later in-session manual toggles
  // already override this via localStorage, exactly as intended by
  // "default".
  simpleModeDefault  Boolean  @default(false)
  // Lets an account declare floors ahead of adding rooms to them (e.g. "this
  // property has 3 floors") — floor chips in the dashboard are the union of
  // this range and whatever floors actual rooms already occupy, so lowering
  // it can never hide a floor that has real rooms on it.
  floorCount          Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  rooms            Room[]
  tenants          Tenant[]
  leases           Lease[]
  invoices         Invoice[]
  floorPlanLayouts FloorPlanLayout[]
}

// Price lives on the Room as the current asking price and can change at any
// time; Lease snapshots the agreed rent separately so past leases/invoices
// are never affected by later price changes.
model Room {
  id          String     @id @default(cuid())
  roomNumber  String
  floor       Int        @default(1)
  // Architectural placement for the U-shaped floor plan view (left_wing,
  // top_wing, right_wing, bottom_facade); null for rooms with no sketch-based
  // layout, which fall back to the flat cinema grid.
  wing        String?
  // Render order within a floor+wing stack (top-to-bottom / left-to-right).
  position    Int        @default(0)
  isVip       Boolean    @default(false)
  // Renders a stairwell hatch divider immediately after this room in its
  // wing's stack, matching a stairwell drawn between rooms on the sketch.
  stairAfter  Boolean    @default(false)
  // Cell coordinates for the freeform "Custom Layout" grid view; null means
  // the room sits in that view's unassigned tray. Independent of wing/
  // position, which drive the separate wing-sketch "Grid" view.
  gridRow     Int?
  gridCol     Int?
  targetPrice Decimal
  status      RoomStatus @default(VACANT)
  userId      String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenants       Tenant[]
  leases        Lease[]
  invoices      Invoice[]
  meterReadings MeterReading[]

  // Room numbers only need to be unique within one owner's portfolio — a
  // global unique would make it impossible for a second registered user to
  // onboard "Room 101..120" once another account (or the NULL-owned demo
  // dataset) already has them.
  @@unique([userId, roomNumber])
  @@index([userId])
}

// Grid size (in cells) for one account's Custom Layout view, one row per
// floor — separate from Room.gridRow/gridCol so an empty grid can be sized
// before any room is placed in it. Absent for a floor means it hasn't been
// customized yet and the UI falls back to a default size.
model FloorPlanLayout {
  id     String @id @default(cuid())
  userId String
  floor  Int
  rows   Int
  cols   Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, floor])
}

// roomId is a denormalized "current room" pointer kept in sync by the
// assign/end-lease actions. Lease.isActive is the source of truth for
// occupancy history; dashboard queries derive occupancy from active leases.
model Tenant {
  id         String   @id @default(cuid())
  fullName   String
  email      String?
  phone      String?
  nationalId String?
  roomId     String?
  userId     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  room     Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  leases   Lease[]
  invoices Invoice[]

  @@index([userId])
}

// The contract between a Tenant and a Room. agreedRent is fixed for the
// lifetime of the lease even if the Room's targetPrice changes later.
model Lease {
  id                    String                @id @default(cuid())
  roomId                String
  tenantId              String
  userId                String?
  agreedRent            Decimal
  startDate             DateTime
  endDate               DateTime?
  isActive              Boolean               @default(true)
  securityDeposit       Decimal?
  securityDepositStatus SecurityDepositStatus @default(HELD)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  room     Room      @relation(fields: [roomId], references: [id], onDelete: Restrict)
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  invoices Invoice[]

  @@index([roomId])
  @@index([tenantId])
  @@index([userId])
}

// A billing record tracked for the dashboard KPIs. "Overdue" is derived at
// query time (status = UNPAID and dueDate < now) rather than flipped by a
// background job, to keep this MVP free of cron jobs.
model Invoice {
  id        String        @id @default(cuid())
  leaseId   String?
  roomId    String
  tenantId  String
  userId    String?
  amountDue Decimal
  dueDate   DateTime
  status    InvoiceStatus @default(UNPAID)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  lease  Lease? @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Restrict)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([roomId])
  @@index([leaseId])
  @@index([userId])
}

// Logs water/electric meter values over time so consumption between two
// readings can be derived (currentValue - previous reading's value).
model MeterReading {
  id                 String   @id @default(cuid())
  roomId             String
  readingDate        DateTime @default(now())
  waterMeterValue    Decimal
  electricMeterValue Decimal
  notes              String?
  createdAt          DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
}
